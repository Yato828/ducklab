# All VITE_ settings are PUBLIC build-time configuration. Never put private keys here.
# The complete game works with this mint empty; optional gated colors stay disabled.
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_QUACK_TOKEN_MINT=
VITE_QUACK_TOKEN_SYMBOL=QUACK
# Human-readable token amount. Converted with the actual onchain mint decimals.
VITE_QUACK_COSMETIC_THRESHOLD=100

# Public brand and real official community links. Leave links empty until available.
VITE_PROJECT_NAME=DUCKLAB
VITE_OFFICIAL_X_URL=
VITE_OFFICIAL_TELEGRAM_URL=
VITE_OFFICIAL_PUMPFUN_URL=
VITE_OFFICIAL_DEXSCREENER_URL=
# Same-origin /api by default; use an HTTPS /api URL for a separately hosted service.
VITE_LEADERBOARD_API_URL=/api

# SERVER ONLY — never prefix these with VITE_. Use private deployment values.
# DATABASE_URL=postgresql://user:password@localhost:5432/ducklab
# RATE_LIMIT_SECRET=<random-private-value-at-least-32-characters>
# ALLOWED_ORIGINS=https://your-real-game-host
# TRUST_PROXY=0
# PORT=8787
