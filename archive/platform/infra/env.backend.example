# Merge with the repository .env.example. Local service credentials only.
APP_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgresql://ducklab:ducklab-local-only@127.0.0.1:5432/ducklab
POSTGRES_PASSWORD=ducklab-local-only
REDIS_URL=redis://127.0.0.1:6379
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
TOKEN_SYMBOL=QUACK
QUACK_TOKEN_MINT=
QUACK_TOKEN_PROGRAM=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
MARKETPLACE_PROGRAM_ID=
MARKETPLACE_TREASURY_ADDRESS=
ALLOW_MAINNET_PAYMENTS=false
# Platform publishing signer, never user private keys. Mount as a read-only secret.
PUBLISHER_KEYPAIR_PATH=
ADMIN_WALLETS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PRIVATE_BUCKET=ducklab-private
S3_PUBLIC_BUCKET=ducklab-public
S3_ACCESS_KEY_ID=ducklab-local
S3_SECRET_ACCESS_KEY=ducklab-local-only
TRAINING_ENABLED=false
# Optional read-only shared GPU artifact mount, when S3 is not configured.
TRAINING_ARTIFACT_ROOT=
