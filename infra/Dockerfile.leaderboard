FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY apps/leaderboard ./apps/leaderboard
COPY apps/web/public/robot ./apps/web/public/robot
COPY apps/web/public/policies ./apps/web/public/policies
COPY packages/game-core ./packages/game-core
COPY packages/simulation-core ./packages/simulation-core
COPY scripts/pin-gameplay.mjs ./scripts/pin-gameplay.mjs
RUN node scripts/pin-gameplay.mjs --check
USER node
ENV HOST=0.0.0.0 PORT=8787 NODE_ENV=production
EXPOSE 8787
CMD ["node", "apps/leaderboard/src/server.mjs"]
